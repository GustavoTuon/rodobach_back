TRAFEGUS_WEB_URL=https://elite.trafegus.com.br/trafeguswebnovo
TRAFEGUS_USER=
TRAFEGUS_PASSWORD=

# Não envia WhatsApp enquanto estiver true.
DRY_RUN=true
POLL_INTERVAL_SECONDS=60
PORT=3340
HOST=127.0.0.1
MONITOR_ADMIN_TOKEN=gere-um-token-aleatorio-com-pelo-menos-32-caracteres
STATE_FILE=./data/state.json

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=rodobach

# Banco do TMS usado para localizar o celular pelo CPF/placa da SM.
CLIENT_DB_HOST=
CLIENT_DB_PORT=5432
CLIENT_DB_NAME=
CLIENT_DB_USER=
CLIENT_DB_PASSWORD=
CLIENT_DB_SSL=false

# Opcional: 55 é acrescentado quando o cadastro tiver apenas DDD+número.
WHATSAPP_COUNTRY_CODE=55
